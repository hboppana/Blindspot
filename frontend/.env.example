# Backend base URL. Leave unset to serve mock data from mock/ (npm run mocks).
# API_BASE_URL=http://localhost:8000

# Browser key: Maps JavaScript API, Maps Static API, Street View Static API.
# Restrict by HTTP referrer.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Optional server key for Street View metadata (capture dates).
# GOOGLE_MAPS_SERVER_KEY=
