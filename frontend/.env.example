# Backend base URL (server-side only). Leave unset to serve mock data from
# mock/ (npm run mocks). Local API: uvicorn api.main:app from the repo root.
# API_BASE_URL=http://localhost:8000

# Browser key: Maps JavaScript API, Places API (New) and Routes API.
# Restrict it to websites: http://localhost:3000/*, https://streetsmart.work/*,
# https://www.streetsmart.work/*
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=
